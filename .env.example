# ---- Service identity ----
SERVICE_NAME=api
ENVIRONMENT=development          # development | staging | production
DEBUG=true
LOG_LEVEL=INFO
LOG_JSON=false                   # true in production

# Comma-separated list of modules this process mounts. One image, many services.
# Available: auth,users,roles,ai
ENABLED_MODULES=auth,users,roles,ai

# ---- HTTP ----
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000   # comma-separated or JSON array

# ---- Database ----
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/app
DB_ECHO=false
DB_POOL_SIZE=10

# ---- Cache / broker ----
REDIS_URL=redis://localhost:6379/0

# ---- Auth ----
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars   # openssl rand -hex 32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- Bootstrap superuser (used by `python -m app.cli seed`) ----
FIRST_SUPERUSER_EMAIL=admin@example.com
FIRST_SUPERUSER_PASSWORD=changeme123

# ---- Background tasks ----
# inline  -> run in-process via asyncio (default, zero infra)
# celery  -> stub; see src/app/tasks/backends/celery_backend.py to enable
TASK_BACKEND=inline
